# İsteğe bağlı: Bu dosyayı ".env" adıyla kopyalayıp doldurabilirsiniz.
# Anahtarları panelden (Ayarlar → Binance API anahtarları) girmek daha kolaydır.

# Gerçek hesap (Binance → API Yönetimi; yalnızca Okuma + Vadeli İşlemler izni, PARA ÇEKME KAPALI)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Testnet / Demo hesap
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Panel şifresi (boş bırakılırsa ilk açılışta panelden belirlenir)
DASHBOARD_PASSWORD=

# Telegram bildirimleri (isteğe bağlı)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Port (varsayılan 8765)
# CANBOT_PORT=8765

# Sunucuya alan adıyla erişecekseniz (ör. VPS), izin verilen adları virgülle yazın.
# IP adresi, localhost, .local ve .ts.net adları zaten izinlidir.
# CANBOT_ALLOWED_HOSTS=bot.ornek.com
