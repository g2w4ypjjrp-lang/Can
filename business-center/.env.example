# Bu dosyayı .env olarak kopyalayın. .env ASLA commit edilmez.

# --- Backend (yalnızca sunucuda) ---
# Supabase > Project Settings > Database > Connection string (Session pooler, port 5432)
BC_DATABASE_URL=postgresql://postgres.PROJE:PAROLA@aws-0-REGION.pooler.supabase.com:5432/postgres
BC_SUPABASE_URL=https://PROJE.supabase.co
# Yalnızca eski (HS256) JWT kullanan projeler için. Boş bırakılırsa JWKS ile doğrulanır.
BC_SUPABASE_JWT_SECRET=
BC_CORS_ORIGINS=["http://localhost:3000"]
BC_ENVIRONMENT=development

# --- AI çekirdeği (Phase 2) ---
# console.anthropic.com > API Keys. Yalnızca backend/worker okur.
BC_ANTHROPIC_API_KEY=
BC_LLM_MODEL=claude-opus-5-5
BC_MAX_TASK_COST_USD=2.0          # tek görevin harcama üst sınırı (USD)
BC_MAX_ACTIVE_TASKS_PER_ORG=3
# Boşsa görevler API süreci içinde çalışır (yalnızca geliştirme). Docker Compose bunu otomatik ayarlar.
BC_REDIS_URL=

# --- Frontend (tarayıcıya gider; gizli bilgi KOYMAYIN) ---
NEXT_PUBLIC_SUPABASE_URL=https://PROJE.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Production (docker-compose.prod.yml) ---
PANEL_DOMAIN=panel.ornek.com
API_DOMAIN=api.ornek.com
# BC_CORS_ORIGINS=["https://panel.ornek.com"]
# NEXT_PUBLIC_API_URL=https://api.ornek.com
BC_TASK_TIMEOUT_MINUTES=30

# Entegrasyon tokenlarının şifreleme anahtarı. Üretmek: cd backend && uv run python -m bizcenter.integrations.keygen
BC_TOKEN_ENCRYPTION_KEY=

# --- Etsy (developers.etsy.com > Your Apps) ---
BC_ETSY_KEYSTRING=
# Etsy x-api-key icin paylasilan sir istiyorsa doldurun ("keystring:secret" olarak gonderilir)
BC_ETSY_SHARED_SECRET=
# Etsy uygulamasinda kayitli yonlendirme adresiyle birebir ayni olmali
BC_ETSY_REDIRECT_URI=https://panel.ornek.com/integrations/etsy/callback

# --- YouTube (Google Cloud Console > APIs: YouTube Data API v3 + YouTube Analytics API; OAuth istemcisi: Web) ---
BC_GOOGLE_CLIENT_ID=
BC_GOOGLE_CLIENT_SECRET=
BC_YOUTUBE_REDIRECT_URI=https://panel.ornek.com/integrations/youtube/callback
