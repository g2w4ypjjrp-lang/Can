# Bulut servisi (cloud/) — üretim ayarları. Gizli bilgi içermez.
ATI_ENVIRONMENT=production
# ATI_DATABASE_URL gizli bilgi deposundan verilir; sslmode=verify-full zorunludur:
#   postgresql://ati_app:<gizli>@<veritabanı-sunucusu>:5432/ati?sslmode=verify-full
ATI_PUBLIC_WEB_URL=https://canarslan.net.tr
ATI_WEB_ORIGINS=["https://canarslan.net.tr"]
ATI_SESSION_COOKIE_SECURE=true
# Yönetici paneli (ayrı alt alan adı). ATI_ADMIN_SECRET_KEK gizli bilgi deposundan verilir.
ATI_ADMIN_PUBLIC_URL=https://admin.canarslan.net.tr
ATI_ADMIN_ORIGINS=["https://admin.canarslan.net.tr"]
# Ödeme sağlayıcısının tarayıcıyı döndürdüğü ve bildirim gönderdiği API adresi. PayTR panelinde
# bildirim adresi: https://api.canarslan.net.tr/v1/payments/webhooks/paytr
ATI_PUBLIC_API_URL=https://api.canarslan.net.tr
# Canlı ödeme yalnızca G3 onayıyla true yapılır. Üretimde test modunda satış açılmaz.
ATI_PAYMENTS_LIVE_ALLOWED=false
ATI_SESSION_DAYS=30
# Yük dengeleyicinin iç adresleri (X-Forwarded-For'a yalnızca bunlardan güvenilir):
ATI_TRUSTED_PROXIES=["10.0.0.0/8"]
