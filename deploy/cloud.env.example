# Bulut servisi (cloud/) — üretim ayarları. Gizli bilgi içermez.
ATI_ENVIRONMENT=production
# ATI_DATABASE_URL gizli bilgi deposundan verilir; sslmode=verify-full zorunludur:
#   postgresql://ati_app:<gizli>@<veritabanı-sunucusu>:5432/ati?sslmode=verify-full
ATI_PUBLIC_WEB_URL=https://canarslan.net.tr
ATI_WEB_ORIGINS=["https://canarslan.net.tr"]
ATI_SESSION_COOKIE_SECURE=true
ATI_SESSION_DAYS=30
# Yük dengeleyicinin iç adresleri (X-Forwarded-For'a yalnızca bunlardan güvenilir):
ATI_TRUSTED_PROXIES=["10.0.0.0/8"]
