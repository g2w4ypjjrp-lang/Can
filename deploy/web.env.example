# Web sitesi (web/) — üretim ayarları. Gizli bilgi içermez.
ATI_ENVIRONMENT=production
ATI_PUBLIC_WEB_URL=https://canarslan.net.tr
ATI_PUBLIC_API_URL=https://api.canarslan.net.tr
# Sunucu tarafı istekler iç ağdan gidebilir (ör. http://ati-cloud-api:8000); yoksa açık adres.
ATI_API_URL=https://api.canarslan.net.tr
ATI_PLANS_REVALIDATE_S=300
# Yönetim paneli yalnızca bu alan adında açılır (aynı derleme ayrı bir dağıtımla da sunulabilir).
ATI_ADMIN_HOST=admin.canarslan.net.tr
NEXT_TELEMETRY_DISABLED=1
