{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Trading Intelligence",
  "version": "0.14.7",
  "identifier": "com.aitradingintelligence.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "AI Trading Intelligence",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "AI Trading Intelligence",
    "copyright": "AI Trading Intelligence",
    "category": "Finance",
    "shortDescription": "Kripto piyasa analizi ve işlem motoru",
    "longDescription": "Binance piyasa verisini analiz eden, fırsatları açıklanabilir puanla gösteren ve risk kapısından geçen işlemleri yöneten masaüstü uygulaması. Kazanç garantisi yoktur.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/engine/": "engine/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Turkish",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdEOTJDNzA2QTNGODg3NDUKUldSRmgvaWpCc2VTZlcxU0Z4UnpYend6dHUyeVJCMFlZQjdUVittUkZmU3d1R3BGR1ZTd29XYVIK",
      "endpoints": [
        "https://api.canarslan.net.tr/v1/updates/{{target}}-{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
