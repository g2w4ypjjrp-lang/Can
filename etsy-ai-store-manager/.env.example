# =============================================================================
# Etsy AI Store Manager — environment template
# Copy to .env (never commit .env). All secrets stay server-side.
# =============================================================================

# --- General -----------------------------------------------------------------
NODE_ENV=production
DOMAIN=example.com
NEXT_PUBLIC_SITE_URL=https://example.com
CORS_ORIGINS=https://example.com

# --- Supabase (Dashboard > Project Settings > API / Database) -----------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable (anon) key — safe for the browser, RLS protects data
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Leave empty for projects using asymmetric JWT signing keys (verified via JWKS).
# Only set for legacy HS256 projects (Settings > API > JWT secret).
SUPABASE_JWT_SECRET=
# Postgres connection used by API/worker (pooler, transaction mode, port 6543). Must use SSL.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_SSL=true

# --- Redis / BullMQ ----------------------------------------------------------
REDIS_PASSWORD=change-me-long-random
REDIS_URL=redis://:change-me-long-random@redis:6379/0

# --- Security ----------------------------------------------------------------
# 32 random bytes, base64:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_VERSION=1
RATE_LIMIT_PER_MINUTE=120
SWAGGER_ENABLED=false
LOG_LEVEL=info

# --- Backups -----------------------------------------------------------------
BACKUP_PASSPHRASE=

# --- Phase 2: Etsy Open API v3 -----------------------------------------------
# Create an app in the Etsy developer portal. Register EXACTLY this callback URL
# (https, case-sensitive, no trailing slash). Used by both api and worker.
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=
ETSY_REDIRECT_URI=https://example.com/api/v1/integrations/etsy/callback
WEB_APP_URL=https://example.com
# Optional: scheduled re-sync interval (ms), default 6h
ETSY_SYNC_EVERY_MS=21600000
# Optional during key rotation: previous keys "1:base64,2:base64"
TOKEN_ENCRYPTION_PREVIOUS_KEYS=

# --- Phase 3: Printify --------------------------------------------------------
# Personal access token: Printify > My Profile > Connections (valid 1 year). api + worker.
PRINTIFY_API_TOKEN=
# Webhook signature secret: openssl rand -hex 20 (webhooks need an https API_PUBLIC_URL)
PRINTIFY_WEBHOOK_SECRET=
API_PUBLIC_URL=https://example.com

# --- Phase 5+: Anthropic Claude API (worker + api) ---------------------------
# console.anthropic.com > API keys. Used server-side only.
ANTHROPIC_API_KEY=

# --- Phase 8: Ad platforms (only those you want to connect) ------------------
META_APP_ID=
META_APP_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
