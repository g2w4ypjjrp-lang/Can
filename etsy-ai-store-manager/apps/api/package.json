{
  "name": "@esm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch --enable-source-maps dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "openapi": "node dist/openapi.js"
  },
  "dependencies": {
    "@esm/shared": "workspace:*",
    "@nestjs/common": "12.6.2",
    "@nestjs/core": "12.6.2",
    "@nestjs/platform-express": "12.6.2",
    "@nestjs/swagger": "12.1.2",
    "@nestjs/throttler": "6.8.0",
    "bullmq": "6.7.10",
    "helmet": "8.3.0",
    "ioredis": "6.1.0",
    "jose": "6.2.18",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7",
    "@esm/integrations": "workspace:*",
    "@esm/profit-engine": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/testing": "12.6.2",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.2"
  }
}
