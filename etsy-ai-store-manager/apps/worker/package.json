{
  "name": "@esm/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch --enable-source-maps dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@esm/shared": "workspace:*",
    "bullmq": "6.7.10",
    "ioredis": "6.1.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.7",
    "@esm/integrations": "workspace:*",
    "@esm/profit-engine": "workspace:*",
    "decimal.js": "10.6.0"
  }
}
