        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Katkı eşikleri ve kâr politikası",
        "tags": [
          "stores"
        ]
      },
      "patch": {
        "operationId": "StoresController_updateProfitRules",
        "parameters": [
          {
            "name": "storeId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "currency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                  },
                  "targetContribution": {
                    "type": "string",
                    "pattern": "^-?\\d{1,10}(\\.\\d{1,2})?$"
                  },
                  "excellentThreshold": {
                    "type": "string",
                    "pattern": "^-?\\d{1,10}(\\.\\d{1,2})?$"
                  },
                  "publishThreshold": {
                    "type": "string",
                    "pattern": "^-?\\d{1,10}(\\.\\d{1,2})?$"
                  },
                  "reviewThreshold": {
                    "type": "string",
                    "pattern": "^-?\\d{1,10}(\\.\\d{1,2})?$"
                  },
                  "minThreshold": {
                    "type": "string",
                    "pattern": "^-?\\d{1,10}(\\.\\d{1,2})?$"
                  },
                  "returnReserveRate": {
                    "type": "string",
                    "pattern": "^(0(\\.\\d{1,4})?|1(\\.0{1,4})?)$"
                  },
                  "remakeReserveRate": {
                    "type": "string",
                    "pattern": "^(0(\\.\\d{1,4})?|1(\\.0{1,4})?)$"
                  },
                  "otherVariableCostRate": {
                    "type": "string",
                    "pattern": "^(0(\\.\\d{1,4})?|1(\\.0{1,4})?)$"
                  },
                  "otherVariableCostFixed": {
                    "type": "string",
                    "pattern": "^-?\\d{1,10}(\\.\\d{1,4})?$"
                  },
                  "defaultAdCostPerOrder": {
                    "type": "string",
                    "pattern": "^-?\\d{1,10}(\\.\\d{1,4})?$"
                  },
                  "taxRateOnProfit": {
                    "type": "string",
                    "pattern": "^(0(\\.\\d{1,4})?|1(\\.0{1,4})?)$"
                  },
                  "vatOnFeesRate": {
                    "type": "string",
                    "pattern": "^(0(\\.\\d{1,4})?|1(\\.0{1,4})?)$"
                  },
                  "offsiteAdsTier": {
                    "type": "string",
                    "enum": [
                      "12",
                      "15"
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "stores"
        ]
