        ]
      },
      "patch": {
        "operationId": "StoresController_updateSettings",
        "parameters": [
          {
            "name": "storeId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "salesStrategy": {
                    "type": "string",
                    "enum": [
                      "growth",
                      "balanced",
                      "profit"
                    ]
                  },
                  "automationLevel": {
                    "type": "string",
                    "enum": [
                      "manual",
                      "controlled",
                      "autonomous_limited"
                    ]
                  },
                  "defaultLanguage": {
                    "type": "string",
                    "enum": [
                      "en",
                      "de",
                      "fr",
                      "es",
                      "it",
                      "pt",
                      "nl",
                      "pl",
                      "ja"
                    ]
                  },
                  "languages": {
                    "minItems": 1,
                    "maxItems": 9,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "en",
                        "de",
                        "fr",
                        "es",
                        "it",
                        "pt",
                        "nl",
                        "pl",
                        "ja"
                      ]
                    }
                  },
                  "targetMarkets": {
                    "maxItems": 60,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Z]{2}$"
                    }
                  },
                  "dailyAdBudgetCap": {
                    "type": "string",
                    "pattern": "^-?\\d{1,10}(\\.\\d{1,2})?$"
                  },
                  "adBudgetCurrency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                  },
                  "sellerCountry": {
                    "type": "string",
                    "pattern": "^[A-Z]{2}$"
                  },
                  "payoutCurrency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                  },
                  "timezone": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "stores"
        ]
      }
    },
    "/api/v1/stores/{storeId}/profit-rules": {
      "get": {
        "operationId": "StoresController_getProfitRules",
        "parameters": [
          {
            "name": "storeId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
