    "/api/v1/stores/{storeId}/finance/simulate": {
      "post": {
        "operationId": "FinanceController_simulate",
        "parameters": [
          {
            "name": "storeId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "unitPrice": {
                    "type": "string",
                    "pattern": "^-?\\d{1,10}(\\.\\d{1,2})?$"
                  },
                  "quantity": {
                    "default": 1,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  },
                  "shippingCharged": {
                    "default": "0",
                    "type": "string",
                    "pattern": "^-?\\d{1,10}(\\.\\d{1,4})?$"
                  },
                  "discount": {
                    "type": "string",
                    "pattern": "^-?\\d{1,10}(\\.\\d{1,4})?$"
                  },
                  "salesTax": {
                    "type": "string",
                    "pattern": "^-?\\d{1,10}(\\.\\d{1,4})?$"
                  },
                  "productionCostPerUnit": {
                    "type": "string",
                    "pattern": "^-?\\d{1,10}(\\.\\d{1,4})?$"
                  },
                  "productionCostCurrency": {
                    "default": "USD",
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                  },
                  "fulfillmentShippingFirst": {
                    "default": "0",
                    "type": "string",
                    "pattern": "^-?\\d{1,10}(\\.\\d{1,4})?$"
                  },
                  "fulfillmentShippingAdditional": {
                    "default": "0",
                    "type": "string",
                    "pattern": "^-?\\d{1,10}(\\.\\d{1,4})?$"
                  },
                  "fulfillmentShippingCurrency": {
                    "default": "USD",
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                  },
                  "buyerCountry": {
                    "type": "string",
                    "pattern": "^[A-Z]{2}$"
                  },
                  "currency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                  },
                  "offsiteAds": {
                    "type": "boolean"
                  },
                  "adCostAllocated": {
                    "type": "string",
                    "pattern": "^-?\\d{1,10}(\\.\\d{1,4})?$"
                  },
                  "save": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "unitPrice",
                  "quantity",
                  "shippingCharged",
                  "productionCostPerUnit",
                  "productionCostCurrency",
                  "fulfillmentShippingFirst",
                  "fulfillmentShippingAdditional",
                  "fulfillmentShippingCurrency",
                  "buyerCountry"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Kârlılık simülasyonu + hedef katkı için fiyat önerisi",
        "tags": [
          "finance"
        ]
      }
    },
