{
  "name": "etsy-ai-store-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI destekli Etsy + Printify mağaza yönetim platformu (modüler monolit)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm build:packages && pnpm --filter \"./apps/*\" run build",
    "build:packages": "pnpm --filter \"./packages/*\" run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "pnpm --filter @esm/web run e2e",
    "db:migrate": "node infrastructure/scripts/migrate.mjs",
    "db:reset:test": "node infrastructure/scripts/migrate.mjs --reset --with-shim",
    "dev:api": "pnpm --filter @esm/api dev",
    "dev:web": "pnpm --filter @esm/web dev",
    "dev:worker": "pnpm --filter @esm/worker dev"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@swc/core": "1.16.22",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "bullmq": "6.7.10",
    "eslint": "10.15.0",
    "ioredis": "6.1.0",
    "jose": "6.2.18",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "prettier": "3.10.1",
    "sharp": "0.35.5",
    "supertest": "7.3.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "sharp",
      "msgpackr-extract"
    ]
  }
}
